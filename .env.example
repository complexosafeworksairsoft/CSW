# Secret used to sign the team-portal (/equipes/*) session cookie (HMAC-SHA256,
# see src/lib/session.ts). Set a long random value in every real environment.
# If unset, the dev server generates a throwaway secret at startup (logged as
# a warning) — fine for local prototyping, but it is NOT persistent, so every
# restart invalidates active sessions. Never commit a real secret.
PORTAL_SECRET=changeme-generate-a-real-secret

# Secret used to sign the site-image admin (/equipes/admin/*) session cookie
# (HMAC-SHA256, see src/lib/admin-session.ts). Fully separate from
# PORTAL_SECRET above — the admin cookie and the team-portal cookie must
# never be able to satisfy each other's session check. Set a long random
# value in every real environment. If unset, the dev server generates a
# throwaway secret at startup (logged as a warning) — fine for local
# prototyping, but it is NOT persistent, so every restart invalidates active
# sessions. Never commit a real secret.
ADMIN_SECRET=changeme-generate-a-real-secret

# Supabase project connection (see src/lib/supabase.ts). Required — every
# data module (teams, roster, agenda, site images, comments/reactions) reads
# and writes through this. Find both values in the Supabase dashboard under
# Project Settings > API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level
# Security, so it must only ever be used server-side (never NEXT_PUBLIC_,
# never sent to the browser) — see src/lib/supabase.ts's file header.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key-from-supabase-dashboard
